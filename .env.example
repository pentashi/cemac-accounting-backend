DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=cemac_db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=3600s

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=mailer-user
MAIL_PASSWORD=mailer-password
MAIL_FROM_NAME=CEMAC Accounting
MAIL_FROM_ADDRESS=no-reply@example.com
FRONTEND_URL=http://localhost:3000

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_TTL=3600

# Replace with a securely generated 64-char hex key. Do not use this example in production.
OTP_ENCRYPTION_KEY=5f2c12609a3dd2eeb049b5e69169f79f2192f3cf16603c2b59ebef34be2b5a17
OTP_ENCRYPTION_ALGORITHM=aes-256-gcm
OTP_EXPIRY=300
OTP_IV_LENGTH=16
OTP_KEY_LENGTH=32
OTP_MAX_ATTEMPTS=3
OTP_PBKDF2_ITERATIONS=100000
OTP_PREFIX=otp:
OTP_RATE_LIMIT_PREFIX=rate_limit:
OTP_RATE_LIMIT_WINDOW=900
OTP_SALT_LENGTH=64
OTP_TAG_LENGTH=16
